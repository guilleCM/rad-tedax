# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=intervencion_radiologica

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_URL=http://localhost:3000

# Seed (optional overrides)
SEED_EMAIL=manager@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Gestor Demo
SEED_LEADER_EMAIL=leader@example.com
SEED_LEADER_PASSWORD=changeme123
SEED_LEADER_NAME=Líder Demo

# Geocoding (Nominatim / OpenStreetMap)
# NOMINATIM_USER_AGENT=IntervencionRadiologica/1.0 (contact@example.com)

# Maptiler
NEXT_PUBLIC_MAPTILER_API_KEY=secret-secure-key