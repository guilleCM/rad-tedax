# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=intervencion_radiologica

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_URL=http://localhost:3000

# Map (optional — defaults to OpenFreeMap Liberty, no API key)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Fallback example (MapTiler free key):
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY

# Seed (optional overrides)
SEED_EMAIL=manager@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Gestor Demo
