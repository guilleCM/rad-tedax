# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=intervencion_radiologica

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_URL=http://localhost:3000

# Map — with NEXT_PUBLIC_MAPTILER_API_KEY: Mapa=Streets-v2, Satélite=Satellite
# Optional override for the "Mapa" basemap only:
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# MapTiler API key (recommended — enables Streets basemap + Satélite)
# Get one at https://cloud.maptiler.com/account/keys/
# NEXT_PUBLIC_MAPTILER_API_KEY=YOUR_KEY

# Seed (optional overrides)
SEED_EMAIL=manager@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Gestor Demo
